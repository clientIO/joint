{
    "compilerOptions": {
        "module": "ES2020",
        "moduleResolution": "bundler",
        "target": "es6",
        "lib": [
            "es2022",
            "dom"
        ],
        "noImplicitAny": false,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "noEmit": true,
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "src"
    ]
}
