{
  "$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
  "baseBranch": "master",
  "access": "public",
  "changelog": "./changelog.cjs",
  "commit": false,
  "ignore": [],
  "fixed": [],
  "linked": [
    [
      "@joint/core",
      "@joint/layout-directed-graph",
      "@joint/layout-msagl",
      "@joint/router-avoid"
    ]
  ],
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": false,
    "tag": false
  },
  "changedFilePatterns": [
    "**",
    "!**/*.test.{js,jsx,ts,tsx,mjs}",
    "!**/test/**",
    "!**/__tests__/**",
    "!**/__mocks__/**",
    "!**/bench/**",
    "!**/demo/**",
    "!**/stories/**",
    "!**/.storybook/**",
    "!**/dist/**",
    "!**/build/**",
    "!**/coverage/**",
    "!**/coverage.json",
    "!**/.tscache/**",
    "!**/scripts/**",
    "!**/grunt/**",
    "!**/Gruntfile.js",
    "!**/Makefile",
    "!**/rollup.config.*",
    "!**/rollup.resources.mjs",
    "!**/vite.config.*",
    "!**/vitest.workspace.*",
    "!**/jest.config.js",
    "!**/jest.react18.config.mjs",
    "!**/karma.conf.js",
    "!**/tsconfig*.json",
    "!**/dts-generator.config.js",
    "!**/knip.json",
    "!**/typedoc.*",
    "!**/.prettierrc*",
    "!**/.gitignore",
    "!**/eslint.config.mjs",
    "!**/*.md",
    "!**/LICENSE"
  ]
}
