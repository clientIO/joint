{
  "name": "@joint/mock-svg",
  "title": "JointJS Mock SVG",
  "version": "0.0.0",
  "description": "Test-runner-agnostic mocks of the SVG globals JSDOM does not implement, required for JointJS testing.",
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://jointjs.com",
  "author": {
    "name": "client IO",
    "url": "https://client.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clientIO/joint.git",
    "directory": "packages/joint-mock-svg"
  },
  "bugs": {
    "url": "https://github.com/clientIO/joint/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "echo \"Publishing via NPM is not allowed!\" && exit 1",
    "prepack": "yarn run dist",
    "dist": "yarn run build",
    "build": "yarn run build:core && yarn run build:types",
    "build:core": "vite build",
    "build:types": "yarn run typecheck",
    "typecheck": "yarn run tsc",
    "tsc": "tsc",
    "test": "jest -c ./test/jest/jest.config.cjs",
    "lint": "eslint .",
    "lint-fix": "yarn run lint --fix"
  },
  "files": [
    "dist/",
    "src/",
    "./LICENSE",
    "./README.md",
    "./SECURITY.md",
    "./CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@joint/core": "workspace:~",
    "@joint/eslint-config": "workspace:*",
    "@tsconfig/node22": "22.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.0",
    "babel-jest": "30.1.2",
    "eslint": "9.39.2",
    "jest": "30.1.2",
    "jest-environment-jsdom": "30.1.2",
    "typescript": "5.8.2",
    "vite": "^5.0.2"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "11.2.0",
    "yarn": "4.18.0"
  },
  "keywords": [
    "jointjs",
    "mock",
    "svg",
    "jsdom",
    "testing"
  ]
}
