{
  "name": "@joint/sanitize",
  "title": "JointJS Sanitize",
  "version": "4.3.3",
  "description": "Sanitizers of untrusted graph JSON and HTML for JointJS",
  "main": "dist/sanitize.js",
  "module": "./src/index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.mjs",
      "require": "./dist/sanitize.js"
    }
  },
  "sideEffects": false,
  "homepage": "https://jointjs.com",
  "author": {
    "name": "client IO",
    "url": "https://client.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clientIO/joint.git",
    "directory": "packages/joint-sanitize"
  },
  "bugs": {
    "url": "https://github.com/clientIO/joint/issues"
  },
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "echo \"Publishing via NPM is not allowed!\" && exit 1",
    "prepack": "yarn run dist",
    "dist": "rollup --config",
    "build": "rollup --config",
    "test": "yarn run build && mocha test/nodejs/nodejs.js && karma start karma.conf.js",
    "test-coverage": "karma start karma.conf.js",
    "test-coverage-lcov": "COVERAGE_REPORTER=lcov yarn run test-coverage",
    "lint": "eslint .",
    "lint-fix": "yarn run lint --fix"
  },
  "files": [
    "./index.d.ts",
    "./src/",
    "./LICENSE",
    "./README.md",
    "./SECURITY.md",
    "./CHANGELOG.md",
    "dist/"
  ],
  "peerDependencies": {
    "@joint/core": ">=4.1.0 <5"
  },
  "devDependencies": {
    "@joint/core": "workspace:~",
    "@joint/eslint-config": "workspace:*",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "chai": "4.2.0",
    "eslint": "9.39.2",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-qunit": "4.2.1",
    "karma-sourcemap-loader": "^0.4.0",
    "mocha": "11.1.0",
    "puppeteer": "24.22.0",
    "qunit": "2.24.1",
    "rollup": "4.36.0",
    "rollup-plugin-banner2": "^1.2.2"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "11.2.0",
    "yarn": "4.18.0"
  },
  "keywords": [
    "jointjs",
    "sanitize",
    "xss",
    "security"
  ]
}
