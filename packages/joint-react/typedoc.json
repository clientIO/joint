{
  "entryPoints": [
    "src/index.ts"
  ],
  "out": "docs/api",
  "readme": "none",
  "name": "@joint/react",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "excludeNotDocumented": false,
  "groupOrder": [
    "Components",
    "Hooks",
    "Selectors",
    "Presets",
    "MVC",
    "Types",
    "Utils",
    "*"
  ],
  "gitRevision": "master",
  "customCss": "typedoc.css",
  "plugin": [
    "typedoc-github-theme"
  ],
  "intentionallyNotExported": ["PaperView"]
}
